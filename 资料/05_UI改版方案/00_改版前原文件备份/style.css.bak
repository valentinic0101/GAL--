/* 深雪 ~miyuki~ 前端样式 */
* { margin: 0; padding: 0; box-sizing: border-box; user-select: none; }
html, body { width: 100%; height: 100%; overflow: hidden; background: #0a0c14; }
body { font-family: "Hiragino Mincho ProN", "Yu Mincho", "Songti SC", "Noto Serif SC", serif; color: #e8ecf4; }

.screen { position: fixed; inset: 0; display: none; }
.screen.active { display: block; }

/* ============ 标题画面 ============ */
#title-screen { background: #0a0c14; }
.title-bg { position: absolute; inset: 0; background: url('../assets/backgrounds/bg_title.png') center/cover; filter: brightness(.92); }
.title-snow { position: absolute; inset: 0; overflow: hidden; }
.title-content { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 40px; }
.game-title { text-align: center; text-shadow: 0 4px 24px rgba(10,14,26,.8); }
.game-title h1 { font-size: 108px; letter-spacing: 42px; margin-left: 42px; font-weight: 600; color: #f4f8fd; text-shadow: 0 0 30px rgba(200,220,255,.55), 0 6px 30px rgba(10,14,26,.9); }
.game-title .subtitle { font-size: 26px; letter-spacing: 14px; color: #b8c8de; margin-top: 8px; font-style: italic; }
.game-title .tagline { margin-top: 26px; font-size: 16px; color: #d0dcea; letter-spacing: 3px; opacity: .9; }
.title-menu { display: flex; flex-direction: column; gap: 14px; margin-top: 10px; }
.title-btn { min-width: 240px; padding: 12px 40px; font-size: 19px; letter-spacing: 8px; font-family: inherit;
  background: linear-gradient(180deg, rgba(28,36,58,.82), rgba(16,22,38,.9));
  color: #e8eef8; border: 1px solid rgba(216,198,138,.55); border-radius: 4px; cursor: pointer; transition: all .25s; }
.title-btn:hover { background: linear-gradient(180deg, rgba(48,62,96,.9), rgba(26,34,56,.95)); border-color: #d8c68a; transform: translateX(4px); }
.title-footer { position: absolute; bottom: 26px; font-size: 12px; color: #93a3bd; letter-spacing: 2px; opacity: .8; }

/* ============ 背景 ============ */
#bg-layer { position: absolute; inset: 0; }
.bg-img { position: absolute; inset: 0; background-size: cover; background-position: center; opacity: 0; transition: opacity 1.1s ease; }
.bg-img.show { opacity: 1; }
#snow-overlay { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
#vignette { position: absolute; inset: 0; pointer-events: none;
  background: radial-gradient(ellipse at center, transparent 55%, rgba(8,10,20,.55) 100%); }

/* ============ 立绘 ============ */
#sprite-layer { position: absolute; inset: 0; pointer-events: none; }
/* 立绘舞台：脚底贴合地面线 + 纵深（远者小、脚线高）+ 环境光匹配 + 接触投影 */
.sprite {
  position: absolute; bottom: 0;
  height: var(--h, 76%); left: var(--x, 50%); transform: translateX(-50%) scale(var(--s, 1));
  transform-origin: 50% 100%;
  transition: opacity .45s ease, left .55s ease, height .4s ease, bottom .4s ease, transform .4s ease;
  opacity: 0;
  will-change: left, height, bottom, opacity, transform;
}
.sprite.on { opacity: 1; }
.sprite.speaking { z-index: 5; }
.sprite img { height: 100%; display: block; }
/* 接触投影：脚下椭圆软阴影（尺寸/浓度由 JS 按场景光照设定） */
.sprite .shadow {
  position: absolute; left: 50%; bottom: -3%;
  transform: translateX(-50%); border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(8,10,18,.9) 0%, rgba(8,10,18,.45) 45%, rgba(8,10,18,0) 72%);
  pointer-events: none;
}

/* ============ 场景标题卡 ============ */
#scene-title-card { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
  background: rgba(6,8,16,.72); z-index: 30; animation: fadeCard 2.4s ease forwards; pointer-events: none; }
#scene-title-card span { font-size: 44px; letter-spacing: 16px; color: #f0f5fc; text-shadow: 0 0 24px rgba(160,190,240,.6); }
@keyframes fadeCard { 0% {opacity:0} 15% {opacity:1} 75% {opacity:1} 100% {opacity:0} }

/* ============ 状态条 ============ */
#status-bar { position: absolute; top: 0; left: 0; right: 0; display: flex; gap: 22px; padding: 10px 20px;
  font-size: 13px; color: #c9d6e8; background: linear-gradient(180deg, rgba(8,10,20,.62), transparent);
  letter-spacing: 1px; z-index: 10; }
#status-bar .warn { color: #ffd9a0; }

/* ============ 对话框 ============ */
#dialog-box { position: absolute; left: 50%; bottom: 30px; transform: translateX(-50%);
  width: min(1060px, 92vw); min-height: 190px; z-index: 20; cursor: pointer;
  background: linear-gradient(180deg, rgba(16,20,34,.88), rgba(10,13,24,.94));
  border: 1px solid rgba(200,212,236,.28); border-radius: 10px; padding: 26px 36px 22px 40px;
  box-shadow: 0 10px 40px rgba(0,0,0,.5); backdrop-filter: blur(6px); }
.corner { position: absolute; width: 26px; height: 26px;
  background: url('../assets/ui/frame_corner.svg') center/contain no-repeat; opacity: .8; }
.corner.tl { top: -8px; left: -8px; } .corner.tr { top: -8px; right: -8px; transform: scaleX(-1); }
.corner.bl { bottom: -8px; left: -8px; transform: scaleY(-1); } .corner.br { bottom: -8px; right: -8px; transform: scale(-1); }
#nameplate { position: absolute; top: -34px; left: 22px; padding: 8px 26px;
  background: linear-gradient(90deg, #232c48, #1a2138); border: 1px solid #d8c68a; border-radius: 6px;
  font-size: 19px; letter-spacing: 6px; color: #f4e9c8; box-shadow: 0 4px 14px rgba(0,0,0,.5); }
#action-text { font-size: 13.5px; color: #9fb2cc; font-style: italic; margin-bottom: 8px; line-height: 1.7; }
#dialog-text { font-size: 21px; line-height: 1.95; letter-spacing: 1px; color: #eef2f9; min-height: 84px; }
#next-indicator { position: absolute; right: 22px; bottom: 12px; color: #d8c68a; font-size: 14px; animation: bounce 1.2s infinite; }
@keyframes bounce { 0%,100% {transform: translateY(0)} 50% {transform: translateY(4px)} }

/* ============ 旁白框 ============ */
#narration-box { position: absolute; left: 50%; bottom: 56px; transform: translateX(-50%);
  width: min(900px, 88vw); z-index: 19; text-align: center; padding: 30px 40px; cursor: pointer;
  background: linear-gradient(180deg, rgba(10,13,24,.35), rgba(10,13,24,.72));
  border-radius: 12px; backdrop-filter: blur(3px); }
#narration-text { font-size: 19px; line-height: 2.05; color: #dfe7f2; font-style: italic; letter-spacing: 1.5px; }
#next-indicator-n { color: #d8c68a; font-size: 13px; margin-top: 12px; animation: bounce 1.2s infinite; }

/* ============ 选项 ============ */
#choice-panel { position: absolute; left: 50%; bottom: 250px; transform: translateX(-50%);
  display: flex; flex-direction: column; gap: 12px; z-index: 22; width: min(640px, 90vw); }
.choice-btn { padding: 13px 26px; font-size: 17.5px; font-family: inherit; letter-spacing: 2px; color: #eef2fa;
  background: linear-gradient(180deg, rgba(30,38,62,.9), rgba(18,24,42,.94));
  border: 1px solid rgba(216,198,138,.5); border-radius: 8px; cursor: pointer; transition: all .2s; text-align: left; }
.choice-btn:hover { border-color: #d8c68a; background: linear-gradient(180deg, rgba(48,62,96,.95), rgba(28,36,58,.98)); transform: translateX(6px); }

/* ============ 自由输入 ============ */
#input-panel { position: absolute; left: 50%; bottom: 250px; transform: translateX(-50%);
  z-index: 22; width: min(700px, 92vw); background: rgba(14,18,32,.92); border: 1px solid rgba(200,212,236,.3);
  border-radius: 12px; padding: 18px 20px; }
.input-hint { font-size: 14px; color: #9fb2cc; margin-bottom: 10px; letter-spacing: 1px; }
.input-row { display: flex; gap: 10px; }
#free-input { flex: 1; padding: 11px 16px; font-size: 17px; font-family: inherit; color: #eef2fa;
  background: rgba(28,36,58,.8); border: 1px solid rgba(216,198,138,.4); border-radius: 6px; outline: none; }
#free-input:focus { border-color: #d8c68a; }
#btn-send { padding: 0 26px; font-size: 16px; font-family: inherit; color: #f4e9c8; cursor: pointer;
  background: linear-gradient(180deg, #2c3a5e, #1c2440); border: 1px solid #d8c68a; border-radius: 6px; }
.input-quick { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
.quick { font-size: 13px; font-family: inherit; color: #b8c8de; background: rgba(28,36,58,.6);
  border: 1px solid rgba(200,212,236,.25); border-radius: 20px; padding: 5px 14px; cursor: pointer; }
.quick:hover { color: #f4e9c8; border-color: #d8c68a; }

/* ============ 幕间面板 ============ */
#interlude-panel { position: absolute; left: 50%; bottom: 40px; transform: translateX(-50%);
  z-index: 21; width: min(980px, 94vw); background: linear-gradient(180deg, rgba(14,18,32,.9), rgba(10,13,24,.95));
  border: 1px solid rgba(200,212,236,.3); border-radius: 12px; padding: 20px 26px; backdrop-filter: blur(6px); }
.inter-note { font-size: 16px; color: #d5deec; line-height: 1.9; margin-bottom: 14px; font-style: italic; }
.inter-actions { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
.inter-btn { padding: 10px 24px; font-size: 15.5px; font-family: inherit; letter-spacing: 2px; color: #eef2fa; cursor: pointer;
  background: linear-gradient(180deg, rgba(30,38,62,.9), rgba(18,24,42,.94));
  border: 1px solid rgba(200,212,236,.35); border-radius: 6px; transition: all .2s; }
.inter-btn:hover { border-color: #d8c68a; color: #f4e9c8; }
.inter-btn.scene-offer { border-color: #d8c68a; color: #ffe9b0; animation: pulse 1.6s infinite; }
@keyframes pulse { 0%,100% { box-shadow: 0 0 0 rgba(216,198,138,0); } 50% { box-shadow: 0 0 18px rgba(216,198,138,.5); } }
.inter-group { display: flex; gap: 8px; align-items: center; }
.grp-label { font-size: 13px; color: #93a3bd; margin-right: 2px; }
#move-btns { display: flex; gap: 8px; }
.move-btn { font-size: 13.5px; font-family: inherit; color: #c9d6e8; cursor: pointer; padding: 8px 16px;
  background: rgba(28,36,58,.7); border: 1px solid rgba(200,212,236,.25); border-radius: 6px; }
.move-btn:hover { border-color: #d8c68a; color: #f4e9c8; }

/* ============ 菜单 ============ */
#menu-bar { position: absolute; top: 10px; right: 16px; display: flex; gap: 8px; z-index: 25; }
.menu-btn { padding: 6px 16px; font-size: 13.5px; font-family: inherit; color: #c9d6e8; cursor: pointer;
  background: rgba(16,20,34,.75); border: 1px solid rgba(200,212,236,.28); border-radius: 5px; letter-spacing: 2px; }
.menu-btn:hover, .menu-btn.on { color: #f4e9c8; border-color: #d8c68a; }
#btn-bgm.off { color: #6d7a90; text-decoration: line-through; }

/* ============ 弹窗 ============ */
#modal { position: fixed; inset: 0; background: rgba(6,8,16,.7); z-index: 50; display: flex; align-items: center; justify-content: center; }
.modal-box { width: min(720px, 92vw); max-height: 78vh; overflow: auto; background: linear-gradient(180deg, #141a2c, #0e1220);
  border: 1px solid rgba(216,198,138,.5); border-radius: 12px; padding: 26px 30px; }
.modal-title { font-size: 20px; letter-spacing: 6px; color: #f4e9c8; margin-bottom: 18px; }
.modal-body { font-size: 15px; line-height: 2; color: #d5deec; }
.log-item { padding: 8px 4px; border-bottom: 1px dashed rgba(200,212,236,.15); }
.log-item .log-name { color: #d8c68a; margin-right: 10px; }
.log-item.narration { font-style: italic; color: #aebfd4; }
.save-slot { display: flex; gap: 10px; align-items: center; margin-bottom: 10px; }
.world-kv { margin: 4px 0; }
.world-kv b { color: #d8c68a; font-weight: normal; }
.rumor { color: #d0a0a8; font-style: italic; }

/* ============ Toast ============ */
#toast { position: fixed; top: 64px; left: 50%; transform: translateX(-50%); z-index: 60;
  background: rgba(20,26,44,.95); border: 1px solid #d8c68a; color: #f4e9c8;
  padding: 10px 28px; border-radius: 6px; font-size: 15px; letter-spacing: 2px; }

/* ============ 等待模型回复指示器（右下角，低调） ============ */
#llm-wait { position: fixed; right: 18px; bottom: 14px; z-index: 40; width: 172px;
  padding: 8px 12px 9px; border-radius: 8px; pointer-events: none;
  background: rgba(16,20,34,.78); border: 1px solid rgba(140,156,188,.22);
  opacity: 0; transform: translateY(6px); transition: opacity .45s ease, transform .45s ease; }
#llm-wait.show { opacity: .82; transform: translateY(0); }
.lw-row { display: flex; align-items: center; gap: 7px; margin-bottom: 6px; }
.lw-dot { width: 5px; height: 5px; border-radius: 50%; background: #d8c68a;
  animation: lwpulse 1.4s ease-in-out infinite; }
@keyframes lwpulse { 0%,100% { opacity:.25; transform: scale(.8);} 50% { opacity:1; transform: scale(1.15);} }
#lw-text { font-size: 11.5px; letter-spacing: 1.5px; color: #aebcd4; flex: 1; }
#lw-sec { font-size: 10.5px; color: #7a8aa8; font-family: Menlo, monospace; }
.lw-track { height: 2px; background: rgba(140,156,188,.18); border-radius: 2px; overflow: hidden; }
.lw-bar { height: 100%; width: 34%; border-radius: 2px;
  background: linear-gradient(90deg, transparent, #d8c68a, transparent);
  animation: lwslide 1.6s linear infinite; }
@keyframes lwslide { 0% { transform: translateX(-110%);} 100% { transform: translateX(410%);} }

.hidden { display: none !important; }

/* ============ 雪花 ============ */
.snowflake { position: absolute; top: -6vh; border-radius: 50%; background: rgba(255,255,255,.85);
  animation-name: fall; animation-timing-function: linear; animation-iteration-count: infinite; pointer-events: none; }
@keyframes fall {
  0% { transform: translate(0, -6vh) translateX(0); }
  25% { transform: translate(4vw, 22vh) translateX(1vw); }
  50% { transform: translate(-3vw, 50vh) translateX(-1vw); }
  75% { transform: translate(3vw, 78vh); }
  100% { transform: translate(-2vw, 108vh); }
}

/* ---- 心之秤（三轴 HUD） ---- */
#st-axes { opacity: .85; letter-spacing: 1px; }
/* ---- 结局卡 ---- */
#ending-card {
  margin: 0 auto 14px; max-width: 560px; text-align: center;
  padding: 18px 22px; border: 1px solid #3a4a6a; border-radius: 10px;
  background: linear-gradient(180deg, rgba(20,28,46,.92), rgba(12,16,28,.92));
  box-shadow: 0 0 24px rgba(140,170,255,.15);
}
#ending-card .ec-label { font-size: 12px; letter-spacing: 6px; color: #8fa0ba; }
#ending-card .ec-title { font-size: 24px; letter-spacing: 8px; color: #f4e9c8; margin: 8px 0 4px; }
#ending-card .ec-btns { margin-top: 12px; display: flex; gap: 10px; justify-content: center; }
#ending-card button {
  padding: 8px 18px; border: 1px solid #4a5a7a; border-radius: 6px;
  background: rgba(40,52,80,.6); color: #d7dfea; cursor: pointer;
}
#ending-card button:hover { background: rgba(70,90,130,.7); }

/* ---- 剧情 CG 全屏 ---- */
#cg-overlay {
  position: fixed; inset: 0; z-index: 60;
  background: rgba(4, 6, 10, .96);
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; animation: cgFade .8s ease;
}
#cg-overlay img { max-width: 100%; max-height: 100%; object-fit: contain; box-shadow: 0 0 60px rgba(0,0,0,.8); }
#cg-overlay .cg-hint {
  position: absolute; right: 18px; bottom: 14px; font-size: 12px;
  color: rgba(215,223,234,.55); letter-spacing: 2px;
}
@keyframes cgFade { from { opacity: 0; } to { opacity: 1; } }

/* 素材缺位角标（优雅降级） */
#bg-note {
  position: absolute; left: 14px; bottom: 12px; z-index: 40;
  font-size: 11px; letter-spacing: 3px; color: rgba(40,52,80,.75);
  background: rgba(255,255,255,.5); border: 1px solid rgba(40,52,80,.25);
  border-radius: 4px; padding: 3px 10px; pointer-events: none;
}
.bg-missing { background-size: cover !important; }
/* 结局卡副标题 */
.ec-sub { font-size: 14px; letter-spacing: 4px; color: #cdd9ef; margin-top: 2px; }
