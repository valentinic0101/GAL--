pisode", "day": 1, "importance": 2, "source": "experience", "keywords": []}, {"content": "叔父说：所以谁来――", "kind": "episode", "day": 1, "importance": 2, "source": "experience", "keywords": []}, {"content": "深雪说：呐", "kind": "episode", "day": 1, "importance": 6, "source": "experience", "keywords": ["深雪", "雪"]}, {"content": "深雪说：我们去外面玩吧", "kind": "episode", "day": 1, "importance": 6, "source": "experience", "keywords": ["深雪", "雪"]}, {"content": "深雪说：因为你，看起来有点无聊哦", "kind": "episode", "day": 1, "importance": 6, "source": "experience", "keywords": ["深雪", "雪"]}, {"content": "修二说：……", "kind": "episode", "day": 1, "importance": 2, "source": "experience", "keywords": []}, {"content": "深雪说：我们走吧", "kind": "episode", "day": 1, "importance": 6, "source": "experience", "keywords": ["深雪", "雪"]}, {"content": "深雪说：呼，好冷啊", "kind": "episode", "day": 1, "importance": 6, "source": "experience", "keywords": ["深雪", "雪"]}, {"content": "深雪说：呐，你喜欢雪吗？", "kind": "episode", "day": 1, "importance": 6, "source": "experience", "keywords": ["深雪", "雪"]}], "father": [], "mother": [], "yukihime": []}, "reflect_points": {"shuuji": 42.0, "miyuki": 16.0, "toba": 0.0, "relative_man": 44.0, "relative_woman": 44.0, "father": 0.0, "mother": 0.0, "yukihime": 0.0}}, "engine": {"mode": "scene", "scene_id": "P1", "beat_idx": 19, "history": [{"name": "旁白", "text": "悲伤，犹如穿过蒙着水汽的窗玻璃照射进来的阳光，模糊而若有若无。父亲和母亲去世了——对我来说，这无比悲戚而沉重的现实，却是那么的平淡无奇。", "action": ""}, {"name": "旁白", "text": "亲戚们总是将简单的道理，说得很拐弯抹角。他们围绕着同一个话题，商议了好几个小时——在亲戚中，到底由谁来收养我。必须有人来抽到这个下下签。", "action": ""}, {"name": "叔父", "text": "麻烦呐――", "action": "（他推了推眼镜，视线游移开）"}, {"name": "婶婶", "text": "虽然我不想直说――", "action": "（她用手掩着嘴）"}, {"name": "叔父", "text": "所以谁来――", "action": "（长辈们的争论声越来越大）"}, {"name": "旁白", "text": "我一个人躲在房间的角落，不去听他们高声争论的内容，一直眺望着檐廊外的风景。白雪在冰冷的天空中，寂静地飞舞着。", "action": ""}, {"name": "旁白", "text": "这时，我感觉有人靠近了这边。", "action": ""}, {"name": "深雪", "text": "呐", "action": "（不知何时，一个女孩子伫立在离我稍远些的地方。她远离长辈们，在一旁凝视着我。仿佛像已这样守望了我许多年）"}, {"name": "旁白", "text": "她没有开口说话，只是默默无言地凝视着我。我感觉只有她身周的氛围有些不同——清澈透明，让人感到安心。", "action": ""}, {"name": "深雪", "text": "我们去外面玩吧", "action": ""}, {"name": "深雪", "text": "因为你，看起来有点无聊哦", "action": "（像是看透了我的心思一样）"}, {"name": "旁白", "text": "她忽然握住了我的手。乌黑的长发随着她的脚步走动，轻轻地沙沙作响。她牵着我的手，穿过如同深海一般深邃的走廊。", "action": ""}, {"name": "修二", "text": "……", "action": ""}, {"name": "深雪", "text": "呼，好冷啊", "action": "（她有些开心地耸了耸肩膀）"}, {"name": "深雪", "text": "我们走吧", "action": "（她有点用力地拽着我的胳膊）"}, {"name": "旁白", "text": "好耀眼——纯白的色彩尽染了整个世界。可以说是一片白暗。冬天的阳光是那么微弱无力，太阳在厚重乌云的另一边微微晃动着。", "action": ""}, {"name": "深雪", "text": "呼，好冷啊", "action": "（她有些开心地耸了耸肩膀，白色的呼气如同热浪一样，溶化在空气中）"}, {"name": "深雪", "text": "呐，你喜欢雪吗？", "action": "（得到解放的她像肋下生出了双翅，在这片凄清冷寂的天地中欢快地奔走）"}, {"name": "旁白", "text": "到底喜欢雪还是不喜欢，我并没有认真地考虑过。我想，我是憎恶着雪的吧。这雪吞没了我的父亲和母亲……明明是如此，但我却怎么都对它恨不起来。", "action": ""}]}}